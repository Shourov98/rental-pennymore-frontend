{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "dev:webpack": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "dev:3030": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1 --port 3030",
    "build": "npm run security:check && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3030",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.13.0",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.29",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "."
  ]
}
